# Generate local values using: node scripts/setup-env.mjs
DATABASE_URL=postgres://agent:REPLACE_LOCALLY@127.0.0.1:5432/agent
ADMIN_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_HEX
POSTGRES_PASSWORD=REPLACE_LOCALLY
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Optional; server side only. Leave unset to use clearly labelled deterministic generation.
OPENAI_API_KEY=
OPENAI_MODEL=
