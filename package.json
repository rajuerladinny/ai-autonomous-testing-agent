{
  "name": "ai-autonomous-testing-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @agent/contracts && npm run build -w @agent/api && npm run build -w @agent/web",
    "build:demo": "node scripts/build-demo.mjs",
    "test": "vitest run",
    "dev:api": "npm run dev -w @agent/api",
    "dev:web": "npm run dev -w @agent/web",
    "start": "npm run start -w @agent/api",
    "check:secrets": "node scripts/check-secrets.mjs",
    "install:browser": "npm run install:browser -w @agent/api"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
